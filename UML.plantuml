@startuml
skinparam backgroundColor #0D1117
skinparam classBackgroundColor #161B22
skinparam classBorderColor #58A6FF
skinparam classFontColor #F0F6FC
skinparam ArrowColor #8B949E
skinparam ArrowFontColor #C9D1D9
skinparam shadowing false

class ABTS_PlayerController {
    +SetupInputComponent()
    +AbilityInputTagPressed(Tag)
}

class UBTS_InputComponent {
    +BindAbilityActions(...)
}

class ABTS_PlayerState

class UBTS_AbilitySystemComponent {
    +AddCharacterAbilities(...)
    +AbilityInputTagPressed(Tag)
    +TryActivateAbility(Handle)
}

class UBTS_AttributeSet {
    -Health
    -Stamina
    -Defense
    -Ammo
    +PostGameplayEffectExecute()
}

class UBTS_GameplayAbility {
    +StartupInputTag
}

ABTS_PlayerController ..> UBTS_InputComponent : binds
ABTS_PlayerController --> UBTS_AbilitySystemComponent : Gameplay Tag
ABTS_PlayerState *-- UBTS_AbilitySystemComponent : owns
ABTS_PlayerState *-- UBTS_AttributeSet : owns
UBTS_AbilitySystemComponent --> UBTS_GameplayAbility : grants / activates
UBTS_AbilitySystemComponent --> UBTS_AttributeSet : Gameplay Effect
@enduml
